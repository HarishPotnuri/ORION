ORION_DATABASE_PATH=/var/lib/orion/orion.sqlite3
ORION_STT_MODEL_PATH=/opt/orion/models/vosk-model-small-en-us-0.15
ORION_AUDIO_QUEUE_CHUNKS=100
# AIRHUG 01 on the Pi: PortAudio `sysdefault` captures correctly; `default` was near-silent.
ORION_AUDIO_DEVICE="sysdefault"
ORION_MODEL_BACKEND=ollama
ORION_MODEL_BASE_URL=http://127.0.0.1:11434
ORION_MODEL_NAME=qwen3:1.7b
ORION_VOICE_PROFILE=legacy
ORION_STT_BACKEND=vosk
ORION_LOG_LEVEL=INFO
HF_HUB_OFFLINE=1
HF_HOME=/var/cache/orion/huggingface
UV_CACHE_DIR=/var/cache/orion/uv-cache
UV_PYTHON_INSTALL_DIR=/opt/orion/python
# Optional local KittenTTS ONNX model directory; otherwise use the offline Hub cache.
# ORION_TTS_MODEL_PATH=/opt/orion/models/tts/kitten-tts-nano-0.2

# Local development-only Hey Jarvis trial. Keep these commented on deployed systems.
# Requires `uv pip install -e '.[voice,wakeword]'` and the three local ONNX files.
# ORION_WAKE_WORD_ENABLED=true
# ORION_WAKE_WORD_MODEL_PATH=models/hey_jarvis.onnx
# ORION_WAKE_WORD_MELSPECTROGRAM_PATH=artifacts/wakeword-staging/melspectrogram.onnx
# ORION_WAKE_WORD_EMBEDDING_PATH=artifacts/wakeword-staging/embedding_model.onnx
# Pi AIRHUG input was measured at 0.094 on a spoken sample; monitor false activations.
# ORION_WAKE_WORD_THRESHOLD=0.08
# ORION_WAKE_WORD_COOLDOWN_SECONDS=3.0

# Future custom Hey Orion profile; not required for the Jarvis trial.
# ORION_VOICE_PROFILE=wakeword
# ORION_STT_BACKEND=whisper.cpp
# ORION_STT_MODEL_PATH=/opt/orion/models/whisper/ggml-base.en.bin
# ORION_WHISPER_CLI_PATH=/usr/local/bin/whisper-cli
# ORION_WAKE_WORD_MODEL_PATH=/opt/orion/models/wakeword/hey_orion.onnx
# ORION_WAKE_WORD_MELSPECTROGRAM_PATH=/opt/orion/models/wakeword/melspectrogram.onnx
# ORION_WAKE_WORD_EMBEDDING_PATH=/opt/orion/models/wakeword/embedding_model.onnx
# ORION_WAKE_WORD_MANIFEST_PATH=/opt/orion/models/wakeword/phase13-artifacts.json